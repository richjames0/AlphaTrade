FROM python:3.10-slim

# Create user
ARG UID
ARG MYUSER
RUN useradd -m -u $UID --create-home ${MYUSER} && \
    echo "${MYUSER}: ${MYUSER}" | chpasswd && \
    adduser ${MYUSER} sudo && \
    chown -R ${MYUSER}:${MYUSER} /home/${MYUSER}

# Default workdir
WORKDIR /home/${MYUSER}/

# Install system dependencies
RUN apt-get update && \
    apt-get install -y --no-install-recommends \
    tmux \
    apt-transport-https \
    ca-certificates \
    gnupg \
    libgl1 \
    p7zip-full \
    unrar-free \
    htop \
    graphviz \
    git \
    wget \
    sudo \
    build-essential \
    && rm -rf /var/lib/apt/lists/*

# Copy requirements
COPY --chown=${MYUSER}:${MYUSER} requirements_tpu.txt /home/${MYUSER}/AlphaTrade/requirements_tpu.txt

# Install JAX for TPU
RUN pip install --upgrade pip setuptools wheel && \
    pip install "jax[tpu]" -f https://storage.googleapis.com/jax-releases/libtpu_releases.html

# Install other requirements
RUN pip install -r /home/${MYUSER}/AlphaTrade/requirements_tpu.txt

# Copy source code
COPY --chown=${MYUSER} --chmod=777 . .

USER ${MYUSER}

# Environment variables
ENV XLA_PYTHON_CLIENT_PREALLOCATE=false
ENV PYTHONPATH="/home/${MYUSER}:$PYTHONPATH"
ENV PATH="$HOME/.local/bin:$PATH"

# Git config (optional, keeping form original)
RUN git config --global --add safe.directory /home/${MYUSER}

# Default command
CMD ["/bin/bash"]
